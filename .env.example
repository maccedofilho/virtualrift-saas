# Modelo de nomes para o backend. Preencha localmente, por serviço.
# Spring Boot lê variáveis exportadas; não carrega este arquivo automaticamente.
# Nunca versione os valores reais. O modelo do frontend fica em:
# frontend/apps/virtualrift-dashboard/.env.example
VIRTUALRIFT_RUNTIME_ENVIRONMENT=
DB_URL=
DB_USER=
DB_PASSWORD=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
REDIS_HOST=
REDIS_PORT=
KAFKA_BOOTSTRAP_SERVERS=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TENANT_INTERNAL_API_KEY=
AUTH_OAUTH_STATE_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_OAUTH_ENABLED=
